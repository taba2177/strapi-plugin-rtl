{
  "name": "strapi-plugin-rtl",
  "version": "1.0.1",
  "description": "Right-to-left (RTL) support for the Strapi 5 admin panel: mirrored interface for Arabic, Hebrew, Persian, Urdu and other RTL languages, and RTL content editing for RTL locales.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-5",
    "plugin",
    "rtl",
    "right-to-left",
    "arabic",
    "hebrew",
    "persian",
    "urdu",
    "i18n",
    "admin",
    "direction"
  ],
  "license": "MIT",
  "author": "taba2177 <tabadev217@gmail.com>",
  "homepage": "https://github.com/taba2177/strapi-plugin-rtl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taba2177/strapi-plugin-rtl.git"
  },
  "bugs": {
    "url": "https://github.com/taba2177/strapi-plugin-rtl/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@strapi/strapi": "^5.61.0",
    "@strapi/sdk-plugin": "^6.1.1",
    "prettier": "^3.9.10",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "react-intl": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.6.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@strapi/typescript-utils": "^5.61.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "rtl",
    "displayName": "RTL Support",
    "description": "Right-to-left admin panel and RTL content editing for Arabic, Hebrew, Persian, Urdu and other RTL languages."
  }
}
